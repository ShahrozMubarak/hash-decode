# Set the actual public HTTPS origin at build time and as a Worker variable.
SITE_ORIGIN=
# Generate an owner credential with scripts/owner-hash.mjs (see START_HERE.md).
OWNER_PASSWORD_HASH=
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Optional truthful geographic service area, e.g. the country you serve.
SERVICE_AREA=

# Your external Cloudflare D1 ID, supplied before build.
D1_DATABASE_ID=
