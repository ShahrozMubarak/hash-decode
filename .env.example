# Runtime configuration. Locally these load from .env/.env.local via the tool
# environment. In production, add these keys in your hosting provider's
# environment settings (Vercel: Project Settings → Environment Variables).
# Never commit real values; .openai/hosting.json must
# only contain project linkage and binding names.
MONGODB_URI=
# Must end in _prod (production), _preview, or _dev (development).
MONGODB_DB_NAME=
# production | preview | development
APP_ENV=
# Exact HTTPS browser origin, e.g. https://example.com (no trailing slash).
APP_ORIGIN=
SITE_ORIGIN=
# 32 random bytes as 64 hex characters. Required to decrypt stored TOTP secrets.
ENCRYPTION_KEY=
# Optional owner bootstrap/break-glass credentials. Prefer `npm run admin:create`;
# these are only used when the database has no owner record or to re-sync the
# owner from the environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional email notifications (Resend).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=
# Optional bot challenge on the login/contact forms. Set both or neither.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Optional truthful geographic service area, e.g. the country you serve.
SERVICE_AREA=

# Your external Cloudflare D1 ID, supplied before build.
D1_DATABASE_ID=

# Optional comma-separated extra origins the browser may connect to / load images from
# (e.g. https://api.example.com,https://cdn.example.com). Added to CSP connect-src/img-src
# so an externally added URL is not denied by the Worker's enforced policy.
CSP_CONNECT_ORIGINS=
CSP_IMG_ORIGINS=
